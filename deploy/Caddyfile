# Caddy config for the static build of WWM GW Planner.
# Copy to /etc/caddy/Caddyfile on the VM. The site address comes from the
# SITE_ADDRESS env var (set via a systemd drop-in — see deploy/README.md), e.g.
#   SITE_ADDRESS=140-238-1-2.sslip.io
# Caddy then auto-provisions + renews a Let's Encrypt certificate for it.

{$SITE_ADDRESS:localhost} {
	root * /var/www/gw-planner
	encode zstd gzip
	file_server

	# Vite emits content-hashed filenames under /assets — cache them forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# App shell + PWA plumbing must always revalidate so new deploys land.
	@nocache path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	header /manifest.webmanifest Content-Type "application/manifest+json"

	log {
		output file /var/log/caddy/gw-planner.log
	}
}
